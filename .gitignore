node_modules/
.next/
.env
.env.local
.env.production
.env.vercel
!.env.example

# Logs
dev-server*.log
*.log

# Ignore all .js files by default (legacy scripts in root)
*.js

# Config files that happen to be .js — re-included after the *.js rule above,
# because gitignore is last-match-wins.
!jest.config.js
!next.config.mjs
!postcss.config.js

# Except tracked scripts in scripts/
!scripts/
!scripts/*.js
.vercel

# Build artifacts
tsconfig.tsbuildinfo

# Office documents
*.docx
*.xlsx
*.pptx


.env*.local
