# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vehicle_tracker"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — omit to hide/disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Email (SendGrid). Both are required — without FROM_EMAIL_ADDRESS no mail is sent.
SENDGRID_API_KEY=""
FROM_EMAIL_ADDRESS=""                # must be a sender/domain verified in SendGrid

# PayPal (billing)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"         # "sandbox" | "live"
PAYPAL_PRO_PLAN_ID=""
PAYPAL_BUSINESS_PLAN_ID=""
PAYPAL_WEBHOOK_ID=""                 # required, webhook verification fails closed without it
NEXT_PUBLIC_PAYPAL_MANAGE_URL=""     # where the customer portal sends users to manage billing

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel KV (rate limiting persistence — without it the limiter is per-instance only)
KV_URL=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Web Push (VAPID - browser push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Wallet passes (optional — Apple Wallet / Google Wallet document passes)
APPLE_TEAM_ID=""
APPLE_PASS_TYPE_ID=""
WALLET_PASS_CERT_PASSWORD=""
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT=""     # service account JSON, as a single-line string

# Analytics & monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Cron
CRON_SECRET="your-cron-secret-here"   # required: /api/cron/notifications returns 401 without it

# One-time bootstrap. Leave EMPTY in normal operation: when set, POST /api/setup and
# POST /api/admin/promote-self accept an `x-setup-secret` header carrying this value
# and can mint a superAdmin. Unset, both endpoints return 404.
SETUP_SECRET=""

# To set up the cron job for document expiry tracking and reminders:
# Vercel Cron Jobs: Add a cron job in vercel.json pointing to /api/cron/notifications
# External (e.g. cron-job.org): GET https://your-domain.com/api/cron/notifications
#   with header: Authorization: Bearer YOUR_CRON_SECRET
# Recommended schedule: daily ("0 8 * * *" or every 24 hours)
